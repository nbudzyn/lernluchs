{
  "name": "lernluchs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\" \".github/workflows/*.yml\" \"*.{json,ts,cjs}\"",
    "lint": "oxlint --type-aware --deny-warnings src tests e2e scripts vite.config.ts playwright.config.ts dependency-cruiser.cjs",
    "test": "vitest",
    "test:unit": "node scripts/test-runner.mjs unit",
    "test:e2e": "node scripts/test-runner.mjs e2e",
    "test:runner": "node --test scripts/test-runner.node.mjs",
    "validate:content": "node scripts/test-runner.mjs unit tests/verticals/topics/topics.test.ts tests/verticals/learning-checks/questionCatalog.test.ts tests/verticals/learning-checks/validateQuestionCatalog.test.ts",
    "check:architecture": "depcruise --config dependency-cruiser.cjs \"src/**/*.ts\" \"src/**/*.tsx\" --output-type err && node --test scripts/check-vertical-scope.node.mjs",
    "check:vertical-scope": "node scripts/check-vertical-scope.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "build": "vite build && node scripts/verify-build.mjs",
    "test:pages-build": "node scripts/test-pages-build.mjs",
    "test:pages-workflow": "node scripts/verify-pages-workflow.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:runner && npm run --silent test:unit && npm run --silent validate:content && npm run check:architecture && npm run check:licenses && npm run build"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "dependency-cruiser": "17.4.3",
    "jsdom": "30.1.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
